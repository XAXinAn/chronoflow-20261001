<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xatodo</groupId>
        <artifactId>xa-todo-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>xa-bootstrap</artifactId>
    <name>xa-bootstrap</name>
    <description>Spring Boot 启动模块：配置、迁移脚本与 Web 入口</description>

    <dependencies>
        <dependency>
            <groupId>com.xatodo</groupId>
            <artifactId>xa-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xatodo</groupId>
            <artifactId>xa-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xatodo</groupId>
            <artifactId>xa-personal</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xatodo</groupId>
            <artifactId>xa-org</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xatodo</groupId>
            <artifactId>xa-admin</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xatodo</groupId>
            <artifactId>xa-support</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.codemonstur</groupId>
            <artifactId>embedded-redis</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- 默认资源目录（配置、Flyway 迁移） -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!--
                合规文本的唯一事实来源在仓库根的 docs/legal/，这里在打包时复制进 jar 的
                classpath:/legal/：LegalController 直接读它，因此**改文案不用改代码**，
                也保证线上链接与应用内 WebView 看到的是同一份文件。
            -->
            <resource>
                <directory>${project.basedir}/../../docs/legal</directory>
                <targetPath>legal</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <!-- 跨语言共享的 API 契约，Java 版与阶段二的 Python 版都对着它校验 -->
            <testResource>
                <directory>${project.basedir}/../../contract</directory>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 测试不依赖外网：关掉节假日自动同步（真实环境默认开启，见 application.yml）。
                         写在这里而不是各测试类的 @DynamicPropertySource：系统属性优先级高于
                         application.yml，一处生效，将来新增测试类也不会漏。 -->
                    <systemPropertyVariables>
                        <HOLIDAY_SYNC_ENABLED>false</HOLIDAY_SYNC_ENABLED>
                        <!-- 按 IP 的验证码日限额在测试里没有意义：整套用例都从同一个「IP」发验证码，
                             用例一多就会随机变红（表现为无关用例报「验证码发送过于频繁」）。
                             手机号维度的限额保持原样，它才是测试真正会碰到的那个。 -->
                        <xatodo.auth.sms-daily-limit-per-ip>100000</xatodo.auth.sms-daily-limit-per-ip>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.xatodo.bootstrap.XaTodoApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
