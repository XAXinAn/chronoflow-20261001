{
  "expo": {
    "name": "XaTodo",
    "slug": "xa-todo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.xatodo.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "用于在地图选点中定位到你的当前位置"
      }
    },
    "android": {
      "package": "com.xatodo.app",
      "edgeToEdgeEnabled": true,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "用于在地图选点中定位到你的当前位置"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://10.0.2.2:8080"
    }
  }
}
