{
  "expo": {
    "name": "时纪流",
    "slug": "chronoflow",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.chronoflow.frontend",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "用于在地图选点中定位到你的当前位置"
      }
    },
    "android": {
      "package": "com.chronoflow.frontend",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "用于在地图选点中定位到你的当前位置"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "用于选择头像、为待办或意见反馈添加图片",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://8.136.20.182:8088"
    }
  }
}
