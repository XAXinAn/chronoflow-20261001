# 时纪流部署环境变量模板。复制成 .env 后填写，**不要提交**（.gitignore 已忽略 .env / .env.*）。

# ---- 必填 ----
# 数据库密码（首次启动时由容器创建；改这一项要连同数据卷一起重置）
DB_PASSWORD=
# 后端签名密钥：换掉所有令牌即失效，建议 openssl rand -base64 48
JWT_SECRET=
# 平台超管初始账号（库为空时自动创建，登录 Web 后台）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- 短信（spec §3.6）----
# log = 不真发（响应里回显验证码，只适合开发）；aliyun = 阿里云短信
SMS_PROVIDER=aliyun
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ---- 地点与地图（spec §5.9）----
# Web 服务 Key（后端搜地点/逆地理，不出服务端）
GEO_AMAP_KEY=
# Web端(JS API) Key 与安全密钥（WebView 画地图，缺了地图白屏）
GEO_AMAP_JS_KEY=
GEO_AMAP_JS_SECURITY_CODE=

# ---- 智能助手「小安」（spec §11 阶段三）----
# 阿里云百炼（通义千问）的 API Key。**留空 = 小安未接入**：接口返回 90002，
# App 显示「还没有接入模型」。在这里填上即可开启，不需要改代码或重新打包。
XATODO_AGENT_API_KEY=
# 模型：默认 qwen3.6-flash；想要长上下文 / 多步推理可换 qwen3.7-plus
XATODO_AGENT_MODEL=qwen3.6-flash
# 上游地址与生成参数（一般不用改）
XATODO_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
XATODO_AGENT_ENABLE_THINKING=false
XATODO_AGENT_MAX_TOKENS=600
# 语音转文字（长按说话）。留空时语音输入提示「未配置」，对话照常可用。
XATODO_ASR_API_KEY=
XATODO_ASR_MODEL=qwen3-asr-flash

# ---- 可选 ----
# 对外端口（默认 8088；这台机器 80/443 被别的站点占着）
WEB_HOST_PORT=8088
# 后端只绑本机，默认 18080
BACKEND_HOST_PORT=18080
# 节假日数据源（默认 GitHub raw；国内机器可换成 jsDelivr 镜像）
# HOLIDAY_SYNC_BASE_URL=https://cdn.jsdelivr.net/gh/NateScarlet/holiday-cn@master
